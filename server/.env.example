# Aether Server Configuration (100% Free / Local First)

# Choose your AI Provider: 'gemini' (Free Tier API) or 'ollama' (Local & 100% Free Offline)
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Ollama local settings (if using local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Server port
PORT=8000
HOST=127.0.0.1
